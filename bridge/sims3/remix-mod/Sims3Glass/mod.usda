#usda 1.0
(
    defaultPrim = "RootNode"
    doc = """The Sims 3 camera hook's glass, car glass, plumbob and mirrors (milestones 80, 101, 105, 109, 114-118;
the water is the Sims3Water mod's since milestone 99, the bumpy glass the generated Sims3GlassBumps mod's
since 109): the materials of the hook's marker textures. The hook presents every glass draw of the game (a
pixel shader reading only cube maps, blended, or one of its named glass shaders) with a flat 32x32 marker
of its glass material at stage 0 and every mirror's face (a cube-only reflective sheet under the stencil
test) with a mirror marker, blending off; this layer makes the markers' hashes the runtime's thin clear
glass, tinted car glass (about 75 % through a pass, a slight green-grey), the plumbob's thin green glass
(each pass 0.5 / 0.92 / 0.55, two sides about the solid gem of milestone 114; no glow since 115) and an
opaque, fully metallic, smooth mirror whose tint is the marker's silver. Each hash is XXH3-64 of the
marker's level 0 (sims3cam::kGlassMaterial, kMirrorMarkerHash, checked by sims3/test/test_sims3cam.cpp).
A thin-walled material's tint is taken over its thin_wall_thickness (the runtime passes the thickness in
the measurement distance's place): at 0.005 the car glass and the plumbob showed no tint (run 222: the
plumbob "lost its green color"), so the tinted ones are 1 thick and one pass lets transmittance_color
through (milestone 118); the clear glass keeps 0.005. (The frosted glass of milestones 88-108 is retired:
bumpy glass is the clear glass with the game's own bump map.)
Deployed to Game/Bin/rtx-remix/mods/Sims3Glass/mod.usda; the runtime reads it while
rtx.enableReplacementAssets is on."""
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "RootNode"
{
    def Scope "Looks"
    {
        def Material "mat_5E30D0B82C246E6C"
        {
            token outputs:mdl:displacement.connect = </RootNode/Looks/mat_5E30D0B82C246E6C/Shader.outputs:out>
            token outputs:mdl:surface.connect = </RootNode/Looks/mat_5E30D0B82C246E6C/Shader.outputs:out>
            token outputs:mdl:volume.connect = </RootNode/Looks/mat_5E30D0B82C246E6C/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @AperturePBR_Translucent.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Translucent"
                float inputs:ior_constant = 1.5
                color3f inputs:transmittance_color = (0.97, 0.98, 0.98)
                float inputs:transmittance_measurement_distance = 1
                bool inputs:thin_walled = 1
                float inputs:thin_wall_thickness = 0.005
                bool inputs:use_diffuse_layer = 0
                token outputs:out
            }
        }

        def Material "mat_8A5EDD7D16D8E741"
        {
            token outputs:mdl:displacement.connect = </RootNode/Looks/mat_8A5EDD7D16D8E741/Shader.outputs:out>
            token outputs:mdl:surface.connect = </RootNode/Looks/mat_8A5EDD7D16D8E741/Shader.outputs:out>
            token outputs:mdl:volume.connect = </RootNode/Looks/mat_8A5EDD7D16D8E741/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @AperturePBR_Translucent.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Translucent"
                float inputs:ior_constant = 1.5
                color3f inputs:transmittance_color = (0.72, 0.78, 0.75)
                float inputs:transmittance_measurement_distance = 1
                bool inputs:thin_walled = 1
                float inputs:thin_wall_thickness = 1
                bool inputs:use_diffuse_layer = 0
                token outputs:out
            }
        }

        def Material "mat_55B2C95B88DA3E67"
        {
            token outputs:mdl:displacement.connect = </RootNode/Looks/mat_55B2C95B88DA3E67/Shader.outputs:out>
            token outputs:mdl:surface.connect = </RootNode/Looks/mat_55B2C95B88DA3E67/Shader.outputs:out>
            token outputs:mdl:volume.connect = </RootNode/Looks/mat_55B2C95B88DA3E67/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @AperturePBR_Translucent.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Translucent"
                float inputs:ior_constant = 1.5
                color3f inputs:transmittance_color = (0.5, 0.92, 0.55)
                float inputs:transmittance_measurement_distance = 1
                bool inputs:thin_walled = 1
                float inputs:thin_wall_thickness = 1
                bool inputs:use_diffuse_layer = 0
                token outputs:out
            }
        }

        def Material "mat_27198C264F1C40A5"
        {
            token outputs:mdl:displacement.connect = </RootNode/Looks/mat_27198C264F1C40A5/Shader.outputs:out>
            token outputs:mdl:surface.connect = </RootNode/Looks/mat_27198C264F1C40A5/Shader.outputs:out>
            token outputs:mdl:volume.connect = </RootNode/Looks/mat_27198C264F1C40A5/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @AperturePBR_Opacity.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Opacity"
                float inputs:metallic_constant = 1
                float inputs:reflection_roughness_constant = 0.02
                token outputs:out
            }
        }
    }
}
